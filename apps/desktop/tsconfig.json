{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["react", "react-dom", "node"],
    "baseUrl": "../..",
    "paths": {
      "@foldermate/shared": ["packages/shared/src/index.ts"],
      "@foldermate/database": ["packages/database/src/index.ts"],
      "@foldermate/config": ["packages/config/src/index.ts"]
    }
  },
  "include": ["src"]
}
