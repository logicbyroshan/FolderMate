{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@foldermate/shared": ["./packages/shared/src/index.ts"],
      "@foldermate/database": ["./packages/database/src/index.ts"],
      "@foldermate/config": ["./packages/config/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "bridges"]
}
